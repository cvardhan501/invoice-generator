# ========================================================
# Invoice Generator Environment Configuration (.env.example)
# Configure these variables in your local .env and in Vercel Project Settings.
# Never commit actual secret keys or credentials to version control.
# ========================================================

# MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority)
MONGODB_URI=

# Optional MongoDB database name (defaults to 'invoice_generator_auth')
MONGODB_DB=invoice_generator_auth

# Resend API Key for dispatching PIN-reset emails
RESEND_API_KEY=

# Verified sender email/domain configured in Resend (e.g. onboarding@resend.dev or invoices@yourdomain.com)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Production base URL (e.g. https://your-app.vercel.app or http://localhost:3000 locally)
APP_BASE_URL=http://localhost:3000

# Fixed administrator email address permitted to receive reset links
ADMIN_RESET_EMAIL=nakshashreyas@gmail.com

# Setup authorization secret required for first-time PIN initialization (/api/auth/setup)
ADMIN_SETUP_SECRET=

# Secret key (at least 32 random characters) used for signing HttpOnly session cookies
SESSION_SECRET=

# Environment mode ('development' or 'production')
NODE_ENV=development

# Local port for development server
PORT=3000
